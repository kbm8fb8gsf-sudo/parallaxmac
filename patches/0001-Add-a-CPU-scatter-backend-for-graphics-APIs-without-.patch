+        //
+        //  CPU backend
+        //  Mirrors Distribute -> OnDistributeComplete -> Evaluate above, using the Burst jobs in CpuScatterJobs.cs
+        //
+
+        /// <summary>
+        /// Schedule the distribution job. The result is processed by CpuScatterSystem.PollDistributions once the job is done,
+        /// like the GPU path's async readback.
+        /// </summary>
+        void CpuDistribute()
+        {
+            count[0] = 0;
+            realCount = 0;
+
+            // Grows as needed, and is compacted once the job is done
+            int initialCapacity = Mathf.Clamp(outputSize, 1, 1024);
+            cpuPositions = new NativeList<PositionData>(initialCapacity, Allocator.Persistent);
+            cpuInstances = new NativeList<CpuScatterInstance>(initialCapacity, Allocator.Persistent);
+
+            Matrix4x4 objectToWorld = parent.quad.meshRenderer.localToWorldMatrix;
+            int populationMultiplier = scatter.distributionParams.populationMultiplier * (int)Mathf.Pow(2, parent.quad.sphereRoot.maxLevel - parent.quad.subdivision);
+
+            CpuDistributeJob job = new CpuDistributeJob
+            {
+                triangles = parent.nativeTriangles,
+                vertices = parent.nativeVertices,
+                normals = parent.nativeNormals,
+                colors = scatter.distributionParams.coloredByTerrain ? parent.nativeColors : CpuScatterSystem.EmptyFloat4,
+                uvs = parent.nativeUVs,
+                directionsFromCenter = parent.nativeDirectionsFromCenter,
+
+                biomeMap = CpuScatterSystem.BiomeMap,
+                biomeMapWidth = CpuScatterSystem.biomeMapWidth,
+                biomeMapHeight = CpuScatterSystem.biomeMapHeight,
+                scatterBiomes = CpuScatterSystem.GetScatterBiomeColors(scatter),
+
+                blockMap = CpuScatterSystem.EmptyFloat,
+                readBlockMap = 0,
+
+                numTriangles = numTriangles,
+                populationMultiplier = populationMultiplier,
+                maxCount = maxCount,
+                seed = scatter.distributionParams.seed + (float)parent.quad.quadIndex,
+                spawnChance = scatter.distributionParams.spawnChance * parent.sphereRelativeDensityMult,
+                maxNormalDeviance = scatter.distributionParams.maxNormalDeviance,
+                minScale = scatter.distributionParams.minScale,
+                maxScale = scatter.distributionParams.maxScale,
+                scaleRandomness = scatter.distributionParams.scaleRandomness,
+
+                noiseMode = GetCpuNoiseMode(),
+                invertNoise = scatter.noiseParams.inverted ? 1 : 0,
+                noiseOctaves = scatter.noiseParams.octaves,
+                noiseFrequency = scatter.noiseParams.frequency,
+                noiseLacunarity = scatter.noiseParams.lacunarity,
+                noiseSeed = scatter.noiseParams.seed,
+                noiseCutoffThreshold = scatter.distributionParams.noiseCutoff,
+
+                steepPower = scatter.distributionParams.steepPower,
+                steepContrast = scatter.distributionParams.steepContrast,
+                steepMidpoint = scatter.distributionParams.steepMidpoint,
+
+                minAltitude = scatter.distributionParams.minAltitude,
+                maxAltitude = scatter.distributionParams.maxAltitude,
+                altitudeFadeRange = scatter.distributionParams.altitudeFadeRange,
+
+                distributeFixedAltitude = scatter.distributionParams.fixedAltitude ? 1 : 0,
+                fixedAltitude = scatter.distributionParams.placementAltitude,
+
+                objectToWorld = objectToWorld,
+                worldToObject = parent.quad.meshRenderer.worldToLocalMatrix,
+                planetNormal = parent.planetNormal,
+                localPlanetNormal = parent.localPlanetNormal,
+                planetOrigin = parent.planetOrigin,
+                planetRadius = parent.planetRadius,
+
+                alignToTerrainNormal = scatter.distributionParams.alignToTerrainNormal,
+                localUp = GetCpuLocalUp(objectToWorld),
+                coloredByTerrain = scatter.distributionParams.coloredByTerrain ? 1 : 0,
+
+                positions = cpuPositions,
+                instances = cpuInstances
+            };
+
+            if (readBlockMap)
+            {
+                job.readBlockMap = 1;
+                job.blockMap = CpuScatterSystem.GetBlockMap(parent.blockMapPQSMod.colorMap, out job.blockMapWidth, out job.blockMapHeight);
+                job.blockMapDirectionFromCenter = (Vector3)parent.blockMapPQSMod.normalisedPosition;
+                job.blockMapRotation = new float4(parent.blockMapPQSMod.rot.x, parent.blockMapPQSMod.rot.y, parent.blockMapPQSMod.rot.z, parent.blockMapPQSMod.rot.w);
+                job.blockMapRadius = (float)parent.blockMapPQSMod.radius;
+            }
+
+            cpuDistributeHandle = job.Schedule();
+            cpuDistributing = true;
+            CpuScatterSystem.AddPendingDistribution(this);
+
+            // Start it now rather than at the next flush, so it is usually done by the next frame
+            JobHandle.ScheduleBatchedJobs();
+        }
+
+        //
+        //  NOTE: PARITY MUST BE MAINTAINED WITH GetDistributeKernel
+        //
+        int GetCpuNoiseMode()
+        {
+            switch (scatter.noiseParams.noiseType)
+            {
+                case NoiseType.simplexCellular:
+                    return CpuScatterMath.NoiseModeCellular;
+                case NoiseType.simplexPolkaDot:
+                    return CpuScatterMath.NoiseModePolkaDot;
+                default:
+                    return CpuScatterMath.NoiseModePerlin;
+            }
+        }
+
+        /// <summary>
+        /// The planet normal the Evaluate kernel aligns scatters to, in the quad's frame. Constant for a quad, so it is applied at distribution time.
+        /// </summary>
+        Vector3 GetCpuLocalUp(Matrix4x4 objectToWorld)
+        {
+            Vector3 planetNormal = Vector3.Normalize(parent.quad.PrecisePosition - parent.quad.sphereRoot.PrecisePosition);
+            float3x3 rotation = new float3x3((float4x4)objectToWorld);
+            rotation /= math.length(rotation.c0);
+            return math.normalize(math.mul(math.transpose(rotation), (float3)planetNormal));
+        }
+
+        public bool CpuDistributionFinished()
+        {
+            return !cpuDistributing || cpuDistributeHandle.IsCompleted;
+        }
+
+        public void CompleteCpuDistribute()
+        {
+            if (cpuDistributing)
+            {
+                cpuDistributeHandle.Complete();
+            }
+        }
+
+        /// <summary>
+        /// CPU equivalent of OnDistributeComplete
+        /// </summary>
+        public void CpuOnDistributeComplete()
+        {
+            if (!cpuDistributing)
+            {
+                return;
+            }
+            cpuDistributeHandle.Complete();
+            cpuDistributing = false;
+
+            // Data was cleaned up before generation completed - stop here
+            if (cleaned)
+            {
+                return;
+            }
+
+            realCount = cpuInstances.Length;
+
+            // Kill this scatter on this quad, nothing was generated
+            if (realCount == 0)
+            {
+                parent.KillChild(this);
+                return;
+            }
+
+            if (CollidersEligible() && !collidersAdded)
+            {
+                NativeArray<PositionData> colliderData = new NativeArray<PositionData>(cpuPositions.Length, Allocator.Persistent, NativeArrayOptions.UninitializedMemory);
+                NativeArray<PositionData>.Copy(cpuPositions.AsArray(), colliderData, cpuPositions.Length);
+
+                collisionData = new ScatterColliderData(parent, colliderData, scatter.collideableArrayIndex);
+                CollisionManager.QueueIncomingData(collisionData);
+                collidersAdded = true;
+            }
+
+            // Positions were only needed for colliders
+            cpuPositions.Dispose();
+
+            cpuInstanceData = new NativeArray<CpuScatterInstance>(realCount, Allocator.Persistent, NativeArrayOptions.UninitializedMemory);
+            NativeArray<CpuScatterInstance>.Copy(cpuInstances.AsArray(), cpuInstanceData, realCount);
+            cpuInstances.Dispose();
+
+            count[0] = realCount;
+            eventAdded = true;
+        }
+
+        void CpuEvaluate()
+        {
+            // Not distributed yet, or the renderer is inactive because the body is unloading
+            if (cpuEvaluating || !cpuInstanceData.IsCreated || scatterRenderer.cpuBuffers == null)
+            {
+                return;
+            }
+
+            if (!cpuOutputLOD0.IsCreated)
+            {
+                cpuOutputLOD0 = new NativeList<CpuScatterInstanceRows>(Allocator.Persistent);
+                cpuOutputLOD1 = new NativeList<CpuScatterInstanceRows>(Allocator.Persistent);
+                cpuOutputLOD2 = new NativeList<CpuScatterInstanceRows>(Allocator.Persistent);
+            }
+
+            float4x4 objectToWorld = parent.quad.meshRenderer.localToWorldMatrix;
+            float3x3 quadRotation = new float3x3(objectToWorld);
+            quadRotation /= math.length(quadRotation.c0);
+
+            float[] planes = RuntimeOperations.floatCameraFrustumPlanes;
+            Vector3 referencePosition = scatter.useCraftPosition ? RuntimeOperations.vectorCraftPos : RuntimeOperations.vectorCameraPos;
+
+            CpuEvaluateJob job = new CpuEvaluateJob
+            {
+                instances = cpuInstanceData,
+                objectToWorld = objectToWorld,
+                quadRotation = quadRotation,
+
+                frustumPlane0 = new float4(planes[0], planes[1], planes[2], planes[3]),
+                frustumPlane1 = new float4(planes[4], planes[5], planes[6], planes[7]),
+                frustumPlane2 = new float4(planes[8], planes[9], planes[10], planes[11]),
+                frustumPlane3 = new float4(planes[12], planes[13], planes[14], planes[15]),
+                frustumPlane4 = new float4(planes[16], planes[17], planes[18], planes[19]),
+                frustumPlane5 = new float4(planes[20], planes[21], planes[22], planes[23]),
+
+                cameraPosition = RuntimeOperations.vectorCameraPos,
+                referencePosition = referencePosition,
+
+                maxRange = scatter.distributionParams.range,
+                cullRadius = scatter.optimizationParams.frustumCullingIgnoreRadius,
+                cullLimit = scatter.optimizationParams.frustumCullingSafetyMargin,
+                rangeFadeStart = ConfigLoader.parallaxGlobalSettings.scatterGlobalSettings.fadeOutStartRange,
+                lod01Split = scatter.distributionParams.lod1.range,
+                lod12Split = scatter.distributionParams.lod2.range,
+
+                lod0 = cpuOutputLOD0,
+                lod1 = cpuOutputLOD1,
+                lod2 = cpuOutputLOD2
+            };
+
+            cpuEvaluateHandle = job.Schedule();
+            cpuEvaluating = true;
+            scatterRenderer.AddCpuSource(this);
+        }
+
+        public void CompleteCpuEvaluate()
+        {
+            if (cpuEvaluating)
+            {
+                cpuEvaluateHandle.Complete();
+                cpuEvaluating = false;
+            }
+        }
+
+        public bool HasCpuEvaluateOutput => cpuOutputLOD0.IsCreated && !cpuEvaluating;
+
+        public NativeList<CpuScatterInstanceRows> GetCpuEvaluateOutput(int lod)
+        {
+            switch (lod)
+            {
+                case 0: return cpuOutputLOD0;
+                case 1: return cpuOutputLOD1;
+                default: return cpuOutputLOD2;
+            }
+        }
+
+        /// <summary>
+        /// Wait for any running jobs and free the CPU backend's memory. Colliders are handled separately, as with the GPU buffers.
+        /// </summary>
+        void CpuRelease()
+        {
+            if (cpuDistributing)
+            {
+                cpuDistributeHandle.Complete();
+                cpuDistributing = false;
+                CpuScatterSystem.RemovePendingDistribution(this);
+            }
+            CompleteCpuEvaluate();
+
+            if (cpuPositions.IsCreated) cpuPositions.Dispose();
+            if (cpuInstances.IsCreated) cpuInstances.Dispose();
+            if (cpuInstanceData.IsCreated) cpuInstanceData.Dispose();
+            if (cpuOutputLOD0.IsCreated) cpuOutputLOD0.Dispose();
+            if (cpuOutputLOD1.IsCreated) cpuOutputLOD1.Dispose();
+            if (cpuOutputLOD2.IsCreated) cpuOutputLOD2.Dispose();
         }
     }
 }
