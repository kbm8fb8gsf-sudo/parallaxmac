diff --git a/Mod Source/Parallax/Scatter System/CPU/CpuScatterJobs.cs b/Mod Source/Parallax/Scatter System/CPU/CpuScatterJobs.cs
new file mode 100644
index 0000000..6c28d6c
--- /dev/null
+++ b/Mod Source/Parallax/Scatter System/CPU/CpuScatterJobs.cs	
@@ -0,0 +1,408 @@
+using Unity.Burst;
+using Unity.Collections;
+using Unity.Jobs;
+using Unity.Mathematics;
+using UnityEngine;
+
+namespace Parallax
+{
+    /// <summary>
+    /// A distributed scatter, with everything that doesn't change frame to frame precomputed.
+    /// </summary>
+    public struct CpuScatterInstance
+    {
+        // Position in the quad's local space
+        public float3 localPos;
+        // Orientation, random rotation and scale in the quad's frame (TransformToPlanetNormal * RotationY * Scale)
+        public float3x3 localRotationScale;
+        // Terrain colour, or white if the scatter is not coloured by the terrain
+        public float3 color;
+        // Random value used for despawning between the fade start range and max range
+        public float despawnChance;
+    }
+
+    /// <summary>
+    /// One instance in _InstanceDataTex - 4 RGBAFloat texels holding the rows of the object to world matrix.
+    /// The last row stores the terrain colour, exactly like TransformData written by the Evaluate kernel.
+    /// </summary>
+    public struct CpuScatterInstanceRows
+    {
+        public float4 row0;
+        public float4 row1;
+        public float4 row2;
+        public float4 row3;
+    }
+
+    /// <summary>
+    /// CPU equivalent of the Distribute kernel in TerrainScatters.compute. Runs once per scatter per quad.
+    /// </summary>
+    [BurstCompile]
+    public struct CpuDistributeJob : IJob
+    {
+        // Quad mesh data
+        [ReadOnly] public NativeArray<int> triangles;
+        [ReadOnly] public NativeArray<float3> vertices;
+        [ReadOnly] public NativeArray<float3> normals;
+        [ReadOnly] public NativeArray<float4> colors;
+        // UV in xy, allowScatter in z
+        [ReadOnly] public NativeArray<float3> uvs;
+        [ReadOnly] public NativeArray<float3> directionsFromCenter;
+
+        // Planet biome map, point sampled
+        [ReadOnly] public NativeArray<Color32> biomeMap;
+        public int biomeMapWidth;
+        public int biomeMapHeight;
+        // Colours of the biomes this scatter can appear in
+        [ReadOnly] public NativeArray<float3> scatterBiomes;
+
+        // Local block map (red channel), bilinearly sampled. Only read if readBlockMap is 1
+        [ReadOnly] public NativeArray<float> blockMap;
+        public int blockMapWidth;
+        public int blockMapHeight;
+        public int readBlockMap;
+        public float3 blockMapDirectionFromCenter;
+        public float4 blockMapRotation;
+        public float blockMapRadius;
+
+        public int numTriangles;
+        public int populationMultiplier;
+        public int maxCount;
+        public float seed;
+        public float spawnChance;
+        public float maxNormalDeviance;
+        public float3 minScale;
+        public float3 maxScale;
+        public float scaleRandomness;
+
+        public int noiseMode;
+        public int invertNoise;
+        public int noiseOctaves;
+        public float noiseFrequency;
+        public float noiseLacunarity;
+        public int noiseSeed;
+        public float noiseCutoffThreshold;
+
+        public float steepPower;
+        public float steepContrast;
+        public float steepMidpoint;
+
+        public float minAltitude;
+        public float maxAltitude;
+        public float altitudeFadeRange;
+
+        public int distributeFixedAltitude;
+        public float fixedAltitude;
+
+        public float4x4 objectToWorld;
+        public float4x4 worldToObject;
+        public float3 planetNormal;
+        public float3 localPlanetNormal;
+        public float3 planetOrigin;
+        public float planetRadius;
+
+        // Evaluate kernel parameters that are constant per object, so they can be precomputed here
+        public int alignToTerrainNormal;
+        // The planet normal in the quad's frame, used when not aligning to the terrain normal
+        public float3 localUp;
+        public int coloredByTerrain;
+
+        // Outputs
+        public NativeList<PositionData> positions;
+        public NativeList<CpuScatterInstance> instances;
+
+        public void Execute()
+        {
+            for (int id = 0; id < numTriangles; id++)
+            {
+                DistributeTriangle(id);
+            }
+        }
+
+        void DistributeTriangle(int id)
+        {
+            if (id * populationMultiplier > maxCount - 1)
+            {
+                return;
+            }
+
+            int index1 = triangles[id * 3];
+            int index2 = triangles[id * 3 + 1];
+            int index3 = triangles[id * 3 + 2];
+
+            // Skip degenerate triangles on the quad mesh
+            if (index1 == index2 || index2 == index3 || index1 == index3)
+            {
+                return;
+            }
+
+            float3 v1 = vertices[index1];
+            float3 v2 = vertices[index2];
+            float3 v3 = vertices[index3];
+
+            float3 uv1 = uvs[index1];
+            float3 uv2 = uvs[index2];
+            float3 uv3 = uvs[index3];
+
+            float3 n1 = normals[index1];
+            float3 n2 = normals[index2];
+            float3 n3 = normals[index3];
+
+            float3 averageNormal = (n1 + n2 + n3) * 0.333333f;
+            float3 centerUV = (uv1 + uv2 + uv3) * 0.333f;
+
+            // Does the biome at the triangle center match any of the biomes this scatter can appear in?
+            float3 biome = SampleBiomeMap(centerUV.xy);
+            bool biomeEligible = false;
+            for (int b = 0; b < scatterBiomes.Length; b++)
+            {
+                if (CpuScatterMath.BiomeEligible(biome, scatterBiomes[b]))
+                {
+                    biomeEligible = true;
+                    break;
+                }
+            }
+            if (!biomeEligible)
+            {
+                return;
+            }
+
+            float slope = CpuScatterMath.CalculateSlope(averageNormal, localPlanetNormal, steepPower, steepContrast, steepMidpoint);
+            if (slope < 0.025f)
+            {
+                slope = 0;
+            }
+
+            float normalDeviance = CpuScatterMath.GetNormalDeviance(n1, n2, n3);
+            if (normalDeviance < 1.0f - maxNormalDeviance)
+            {
+                return;
+            }
+
+            float3 dfc1 = directionsFromCenter[index1];
+            float3 dfc2 = directionsFromCenter[index2];
+            float3 dfc3 = directionsFromCenter[index3];
+
+            // Per-triangle data used by the Evaluate kernel
+            float3 faceNormal = math.normalize(math.cross(v2 - v1, v3 - v1));
+            float3x3 alignment = CpuScatterMath.TransformToPlanetNormal(new float3(0, 1, 0), alignToTerrainNormal == 0 ? localUp : faceNormal);
+            float3 color = new float3(1, 1, 1);
+            if (coloredByTerrain == 1)
+            {
+                color = (colors[index1].xyz + colors[index2].xyz + colors[index3].xyz) * 0.333f;
+            }
+
+            float3 randomSeed = new float3((float)(uint)index1 + seed, (float)(uint)index2, (float)id);
+
+            for (int i = 0; i < populationMultiplier; i++)
+            {
+                float random1 = CpuScatterMath.Rand(randomSeed + i);
+                float random2 = CpuScatterMath.Rand(randomSeed - i);
+                float random3 = CpuScatterMath.Rand(randomSeed * 0.5f + i);
+                float random4 = CpuScatterMath.Rand(randomSeed * 0.5f - i);
+                float random5 = CpuScatterMath.Rand(randomSeed * 0.25f + i);
+
+                // X must be sqrtd to achieve a uniform distribution
+                float randomX = math.sqrt(random1);
+                float randomY = random2;
+                float3 localPos = CpuScatterMath.RandomPoint(v1, v2, v3, randomX, randomY);
+                float3 localCenterDir = CpuScatterMath.RandomPoint(dfc1, dfc2, dfc3, randomX, randomY);
+                float localAllowScatter = CpuScatterMath.RandomFloat(uv1.z, uv2.z, uv3.z, randomX, randomY);
+
+                if (readBlockMap == 1)
+                {
+                    float quadAngle = math.acos(math.dot(localCenterDir, blockMapDirectionFromCenter));
+                    float inclusionAngle = math.atan(blockMapRadius / planetRadius);
+
+                    if (quadAngle < inclusionAngle)
+                    {
+                        float3 vertexRotation = CpuScatterMath.QuaternionMul(blockMapRotation, localCenterDir);
+
+                        float u = (vertexRotation.x * planetRadius / blockMapRadius + 1.0f) * 0.5f;
+                        float v = (vertexRotation.z * planetRadius / blockMapRadius + 1.0f) * 0.5f;
+
+                        if (SampleBlockMap(new float2(u, v)) < 0.5f)
+                        {
+                            localAllowScatter = 0;
+                        }
+                    }
+                }
+
+                float noise = CpuScatterMath.Noise(localCenterDir, noiseMode, noiseSeed, noiseFrequency, noiseLacunarity, noiseOctaves, invertNoise);
+
+                float noiseScale = CpuScatterMath.LerpStep(noiseCutoffThreshold, 1, noise);
+                float scaleInterpolant = math.lerp(noiseScale, random3, scaleRandomness);
+                float3 scale = math.lerp(minScale, maxScale, scaleInterpolant);
+
+                float3 worldPos = math.mul(objectToWorld, new float4(localPos, 1)).xyz;
+
+                float altitude = math.length(worldPos - planetOrigin) - planetRadius;
+                float altitudeScalar = CpuScatterMath.GetAltitudeScalar(altitude, minAltitude, maxAltitude, altitudeFadeRange);
+
+                if (distributeFixedAltitude == 1)
+                {
+                    float altitudeDiff = altitude - fixedAltitude;
+                    worldPos -= planetNormal * altitudeDiff;
+                    localPos = math.mul(worldToObject, new float4(worldPos, 1)).xyz;
+                }
+
+                float vertexAllowScatter = localAllowScatter > 0.5f ? 1 : 0;
+                bool canSpawn = (random4 < spawnChance * altitudeScalar * slope * vertexAllowScatter) && (noise > noiseCutoffThreshold);
+
+                if (canSpawn)
+                {
+                    float rotation = random5 * 180.0f;
+
+                    positions.Add(new PositionData
+                    {
+                        localPos = localPos,
+                        localScale = scale,
+                        rotation = rotation,
+                        index = (uint)(id * 3)
+                    });
+
+                    instances.Add(new CpuScatterInstance
+                    {
+                        localPos = localPos,
+                        localRotationScale = math.mul(alignment, math.mul(CpuScatterMath.RotationY(rotation), float3x3.Scale(scale))),
+                        color = color,
+                        despawnChance = CpuScatterMath.Rand(localPos)
+                    });
+                }
+            }
+        }
+
+        // Point, clamp
+        float3 SampleBiomeMap(float2 uv)
+        {
+            if (biomeMap.Length == 0)
+            {
+                // No biome data available - treat every biome as eligible
+                return scatterBiomes.Length > 0 ? scatterBiomes[0] : float3.zero;
+            }
+            int x = math.clamp((int)math.floor(uv.x * biomeMapWidth), 0, biomeMapWidth - 1);
+            int y = math.clamp((int)math.floor(uv.y * biomeMapHeight), 0, biomeMapHeight - 1);
+            Color32 c = biomeMap[y * biomeMapWidth + x];
+            return new float3(c.r, c.g, c.b) * (1.0f / 255.0f);
+        }
+
+        // Bilinear, clamp
+        float SampleBlockMap(float2 uv)
+        {
+            if (blockMap.Length == 0)
+            {
+                return 1;
+            }
+            float x = uv.x * blockMapWidth - 0.5f;
+            float y = uv.y * blockMapHeight - 0.5f;
+            float fx0 = math.floor(x);
+            float fy0 = math.floor(y);
+            float tx = x - fx0;
+            float ty = y - fy0;
+            int x0 = math.clamp((int)fx0, 0, blockMapWidth - 1);
+            int y0 = math.clamp((int)fy0, 0, blockMapHeight - 1);
+            int x1 = math.clamp((int)fx0 + 1, 0, blockMapWidth - 1);
+            int y1 = math.clamp((int)fy0 + 1, 0, blockMapHeight - 1);
+            float bottom = math.lerp(blockMap[y0 * blockMapWidth + x0], blockMap[y0 * blockMapWidth + x1], tx);
+            float top = math.lerp(blockMap[y1 * blockMapWidth + x0], blockMap[y1 * blockMapWidth + x1], tx);
+            return math.lerp(bottom, top, ty);
+        }
+    }
+
+    /// <summary>
+    /// CPU equivalent of the Evaluate kernel in TerrainScatters.compute. Runs every frame per scatter per visible quad.
+    /// Frustum and range culls the distributed objects, then sorts them into the three LODs.
+    /// </summary>
+    [BurstCompile]
+    public struct CpuEvaluateJob : IJob
+    {
+        [ReadOnly] public NativeArray<CpuScatterInstance> instances;
+
+        public float4x4 objectToWorld;
+        // The quad's rotation with its scale removed
+        public float3x3 quadRotation;
+
+        public float4 frustumPlane0;
+        public float4 frustumPlane1;
+        public float4 frustumPlane2;
+        public float4 frustumPlane3;
+        public float4 frustumPlane4;
+        public float4 frustumPlane5;
+
+        public float3 cameraPosition;
+        // Camera or craft position, used for range culling
+        public float3 referencePosition;
+
+        public float maxRange;
+        public float cullRadius;
+        public float cullLimit;
+        public float rangeFadeStart;
+        public float lod01Split;
+        public float lod12Split;
+
+        public NativeList<CpuScatterInstanceRows> lod0;
+        public NativeList<CpuScatterInstanceRows> lod1;
+        public NativeList<CpuScatterInstanceRows> lod2;
+
+        public void Execute()
+        {
+            lod0.Clear();
+            lod1.Clear();
+            lod2.Clear();
+
+            for (int i = 0; i < instances.Length; i++)
+            {
+                CpuScatterInstance instance = instances[i];
+                float3 worldPos = math.mul(objectToWorld, new float4(instance.localPos, 1)).xyz;
+
+                float4 cd0 = new float4(
+                    math.dot(frustumPlane0.xyz, worldPos) + frustumPlane0.w,
+                    math.dot(frustumPlane1.xyz, worldPos) + frustumPlane1.w,
+                    math.dot(frustumPlane2.xyz, worldPos) + frustumPlane2.w,
+                    math.dot(frustumPlane3.xyz, worldPos) + frustumPlane3.w);
+                float4 cd1 = new float4(
+                    math.dot(frustumPlane4.xyz, worldPos) + frustumPlane4.w,
+                    math.dot(frustumPlane5.xyz, worldPos) + frustumPlane5.w,
+                    0.00001f,
+                    0.00001f);
+
+                float lodDist = math.distance(cameraPosition, worldPos) / maxRange;
+                float cullingDistance = math.distance(referencePosition, worldPos) / maxRange;
+
+                if (cullingDistance > 1)
+                {
+                    continue;
+                }
+                if (!(math.all(cd0 >= cullLimit) && math.all(cd1 >= cullLimit)) && cullingDistance > cullRadius)
+                {
+                    continue;
+                }
+
+                // Random chance to despawn between the fade start range and the max range
+                if (instance.despawnChance < CpuScatterMath.GetPercentageBetween(cullingDistance, rangeFadeStart, 1))
+                {
+                    continue;
+                }
+
+                float3x3 m = math.mul(quadRotation, instance.localRotationScale);
+                CpuScatterInstanceRows rows;
+                rows.row0 = new float4(m.c0.x, m.c1.x, m.c2.x, worldPos.x);
+                rows.row1 = new float4(m.c0.y, m.c1.y, m.c2.y, worldPos.y);
+                rows.row2 = new float4(m.c0.z, m.c1.z, m.c2.z, worldPos.z);
+                rows.row3 = new float4(instance.color, 1);
+
+                if (lodDist > lod12Split)
+                {
+                    lod2.Add(rows);
+                }
+                else if (lodDist > lod01Split)
+                {
+                    lod1.Add(rows);
+                }
+                else
+                {
+                    lod0.Add(rows);
+                }
+            }
+        }
+    }
+}
